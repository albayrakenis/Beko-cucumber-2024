name: Cucumber Test Workflow

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Kodu Checkout Et
        uses: actions/checkout@v3

      - name: Java 17 Kurulumu
        uses: actions/setup-java@v3
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Maven ile Testleri Çalıştır
        run: mvn clean test

      - name: Allure Raporu Oluştur
        run: mvn allure:report

      - name: Raporu Artifact Olarak Yükle
        uses: actions/upload-artifact@v3
        with:
          name: allure-report
          path: target/site/allure-maven-plugin

      - name: E-posta ile Rapor Gönder
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: smtp.gmail.com
          server_port: 465
          username: ${{ secrets.EMAIL_USER }}
          password: ${{ secrets.EMAIL_PASS }}
          subject: Cucumber Test Sonuçları
          to: alici@example.com
          from: ${{ secrets.EMAIL_USER }}
          body: |
            Merhaba,
            
            Cucumber testleri tamamlandı. Allure raporunu aşağıdaki linkten indirebilirsiniz:
            
            https://github.com/albayrakenis/Beko-cucumber-2024/actions/runs/${{ github.run_id }}
            
            İyi çalışmalar.
